# Server-only. Never prefix these with EXPO_PUBLIC_.

# Chat. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Speech. Create a token at https://huggingface.co/settings/tokens
# with permission to call Inference Providers.
HF_TOKEN=
HF_STT_MODEL=openai/whisper-large-v3

# One speech model per language. Do not point all three at a model
# until that model has been heard in each language.
HF_TTS_MODEL_EN=microsoft/speecht5_tts
HF_TTS_MODEL_ES=facebook/mms-tts-spa
HF_TTS_MODEL_ZH=facebook/mms-tts-cmn
